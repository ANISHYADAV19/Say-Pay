# Copy this file to `.env.local` and fill in your key. NEVER commit real secrets.
#
# IMPORTANT: these are SERVER-SIDE variables consumed only by the /api/parse
# serverless function. Do NOT prefix them with VITE_ — Vite inlines VITE_*
# vars into the client bundle, which would leak your key to the browser.

# Which provider the proxy calls. Currently supported: "gemini".
LLM_PROVIDER=gemini

# Model id. Get a free key at https://aistudio.google.com/app/apikey
# Pick a current fast model (e.g. gemini-2.0-flash / gemini-2.5-flash).
LLM_MODEL=gemini-2.0-flash

# Your Google AI Studio API key.
LLM_API_KEY=paste-your-google-ai-studio-key-here
